rules_version = '2';

// Anyone signed in with Google can use the app.
// A profile may only be tagged with a university if the person's Google email
// really belongs to that university (so a Gmail user can't claim to be from SMU).
//
// Keep the university domains in sync with src/config/universities.js,
// and the questionnaire options in sync with src/config/preferences.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailEndsWith(pattern) {
      return request.auth.token.email_verified == true
        && myEmail().matches('^[^@\\s]+@' + pattern + '$');
    }

    // universityId / universityName must match the signed-in email, or both be null.
    function universityIsHonest(data) {
      return (data.universityId == null && data.universityName == null)
        || (data.universityId == 'smu'  && data.universityName == 'SMU'  && emailEndsWith('([a-z0-9-]+\\.)*smu\\.edu\\.sg'))
        || (data.universityId == 'nus'  && data.universityName == 'NUS'  && emailEndsWith('u\\.nus\\.edu'))
        || (data.universityId == 'ntu'  && data.universityName == 'NTU'  && emailEndsWith('e\\.ntu\\.edu\\.sg'))
        || (data.universityId == 'sutd' && data.universityName == 'SUTD' && emailEndsWith('mymail\\.sutd\\.edu\\.sg'))
        || (data.universityId == 'sit'  && data.universityName == 'SIT'  && emailEndsWith('sit\\.singaporetech\\.edu\\.sg'))
        || (data.universityId == 'suss' && data.universityName == 'SUSS' && emailEndsWith('suss\\.edu\\.sg'));
    }

    // Questionnaire answers must use the options in src/config/preferences.js.
    function validPreferences(p) {
      return p.keys().hasOnly(['interests', 'maxBudget', 'energyLevel', 'groupPreference'])
        && p.interests is list
        && p.interests.size() >= 1
        && p.interests.size() <= 9
        && p.interests.hasOnly(['outdoors', 'sports', 'arts', 'food', 'workshops',
                                'events', 'games', 'wellness', 'volunteering'])
        && (p.maxBudget == null || p.maxBudget in [0, 10, 20, 50])
        && p.energyLevel in ['low', 'medium', 'high']
        && p.groupPreference in ['solo', 'group', 'either'];
    }

    match /activities/{id} {
      allow read: if signedIn();
      allow write: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    match /users/{uid} {
      // Signed-in users can see profiles (needed for friends and leaderboards).
      allow read: if signedIn();

      // You can only create your own profile, with your own email, starting at 0 points.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points == 0
        && universityIsHonest(request.resource.data);

      // You can edit your own profile, but not your email, university or points.
      // Questionnaire answers (preferences) must be valid.
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['email', 'universityId', 'universityName', 'points'])
        && (!request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['preferences', 'preferencesVersion'])
            || (validPreferences(request.resource.data.preferences)
                && request.resource.data.preferencesVersion == 2));

      allow delete: if false;
    }

    // ---------- OPENJIO! (see OPENJIO.md) ----------
    // Keep these limits in sync with validateJio() in src/utils/openjio.js.
    function validJio(d) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 60
        && d.category in ['outdoors', 'sports', 'arts', 'food', 'workshops',
                          'events', 'games', 'wellness', 'volunteering']
        && d.location is string && d.location.size() >= 1 && d.location.size() <= 80
        && d.region in ['central', 'north', 'north-east', 'east', 'west', 'south']
        && d.description is string && d.description.size() <= 300
        && d.startAt is timestamp
        && d.durationMins is int && d.durationMins >= 15 && d.durationMins <= 720
        && d.cost is number && d.cost >= 0 && d.cost <= 500
        && d.capacity is int && d.capacity >= 2 && d.capacity <= 50
        && d.visibility in ['public', 'friends']
        && d.status in ['open', 'cancelled']
        && d.participants is list && d.participants.size() <= d.capacity
        && d.participants.size() == d.participants.toSet().size() // no duplicates
        && d.waitlist is list && d.waitlist.size() <= 200
        // friends-only jios list who is invited (older jios may not have the field)
        && (!('invited' in d) || (d.invited is list && d.invited.size() <= 50));
    }

    // Public jios: anyone. Friends-only: only people the host invited
    // (or who are already in it).
    function mayJoin(jio, uid) {
      return jio.visibility == 'public'
        || jio.get('invited', []).hasAny([uid])
        || jio.participants.hasAny([uid])
        || jio.waitlist.hasAny([uid]);
    }

    // Join, chope or leave: you may only add or remove yourself.
    // The one exception: when you leave, the first person in the queue
    // moves into your spot.
    function fairSpotChange() {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let beforeEveryone = before.participants.toSet().union(before.waitlist.toSet());
      return after.diff(before).affectedKeys().hasOnly(['participants', 'waitlist'])
        && before.status == 'open'
        && mayJoin(before, me)
        && after.participants.hasAny([before.hostId])
        // only you (or someone from the queue) can be added to the going list
        && after.participants.toSet().difference(beforeEveryone).hasOnly([me])
        // only you can be added to the queue
        && after.waitlist.toSet().difference(before.waitlist.toSet()).hasOnly([me])
        // only you can be removed from the going list
        && before.participants.toSet().difference(after.participants.toSet()).hasOnly([me])
        // only you can leave the queue, unless the person moved up into a spot
        && before.waitlist.toSet().difference(after.waitlist.toSet())
             .difference(after.participants.toSet()).hasOnly([me]);
    }

    match /openjios/{jioId} {
      // Signed-in users can read jios. "Friends only" is filtered in the app
      // (only the host, invited friends and people in it see it).
      allow read: if signedIn();

      // You can only host as yourself, and start as the only person going.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'category', 'description', 'location',
             'region', 'lat', 'lng', 'startAt', 'durationMins', 'cost', 'capacity', 'visibility',
             'hostId', 'hostName', 'participants', 'waitlist', 'invited', 'status', 'createdAt'])
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.waitlist == []
        && request.resource.data.status == 'open'
        && request.resource.data.invited is list
        && ((request.resource.data.visibility == 'friends' && request.resource.data.invited.size() >= 1)
            || (request.resource.data.visibility == 'public' && request.resource.data.invited.size() == 0))
        && request.resource.data.startAt > request.time
        && request.resource.data.createdAt == request.time
        && validJio(request.resource.data);

      // The host can edit or cancel their jio (but not who is going).
      // Anyone else can only join, chope or leave.
      allow update: if signedIn() && validJio(request.resource.data) && (
        (resource.data.hostId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['hostId', 'hostName', 'participants', 'waitlist', 'createdAt']))
        || fairSpotChange()
      );

      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    // Everything else is closed until we add rules for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
