rules_version = '2';

// Anyone signed in with Google can use the app.
// A profile may only be tagged with a university if the person's Google email
// really belongs to that university (so a Gmail user can't claim to be from SMU).
//
// Keep the university domains in sync with src/config/universities.js,
// and the questionnaire options in sync with src/config/preferences.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailEndsWith(pattern) {
      return request.auth.token.email_verified == true
        && myEmail().matches('^[^@\\s]+@' + pattern + '$');
    }

    // universityId / universityName must match the signed-in email, or both be null.
    function universityIsHonest(data) {
      return (data.universityId == null && data.universityName == null)
        || (data.universityId == 'smu'  && data.universityName == 'SMU'  && emailEndsWith('([a-z0-9-]+\\.)*smu\\.edu\\.sg'))
        || (data.universityId == 'nus'  && data.universityName == 'NUS'  && emailEndsWith('u\\.nus\\.edu'))
        || (data.universityId == 'ntu'  && data.universityName == 'NTU'  && emailEndsWith('e\\.ntu\\.edu\\.sg'))
        || (data.universityId == 'sutd' && data.universityName == 'SUTD' && emailEndsWith('mymail\\.sutd\\.edu\\.sg'))
        || (data.universityId == 'sit'  && data.universityName == 'SIT'  && emailEndsWith('sit\\.singaporetech\\.edu\\.sg'))
        || (data.universityId == 'suss' && data.universityName == 'SUSS' && emailEndsWith('suss\\.edu\\.sg'));
    }

    // Questionnaire answers must use the options in src/config/preferences.js.
    function validPreferences(p) {
      return p.keys().hasOnly(['interests', 'maxBudget', 'energyLevel', 'groupPreference'])
        && p.interests is list
        && p.interests.size() >= 1
        && p.interests.size() <= 9
        && p.interests.hasOnly(['outdoors', 'sports', 'arts', 'food', 'workshops',
                                'events', 'games', 'wellness', 'volunteering'])
        && (p.maxBudget == null || p.maxBudget in [0, 10, 20, 50])
        && p.energyLevel in ['low', 'medium', 'high']
        && p.groupPreference in ['solo', 'group', 'either'];
    }

    match /activities/{id} {
      allow read: if signedIn();
      allow write: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    match /users/{uid} {
      // Signed-in users can see profiles (needed for friends and leaderboards).
      allow read: if signedIn();

      // You can only create your own profile, with your own email, starting at 0 points.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.points == 0
        && universityIsHonest(request.resource.data);

      // You can edit your own profile, but not your email, university or points.
      // Questionnaire answers (preferences) must be valid.
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['email', 'universityId', 'universityName', 'points'])
        && (!request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['preferences', 'preferencesVersion'])
            || (validPreferences(request.resource.data.preferences)
                && request.resource.data.preferencesVersion == 2));

      allow delete: if false;
    }

    // ---------- Friends & notifications ----------
    // Same id whoever sent the request: the two uids sorted, joined with "_".
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function friendshipPath(a, b) {
      return /databases/$(database)/documents/friendships/$(pairId(a, b));
    }
    function areFriends(a, b) {
      return exists(friendshipPath(a, b)) && get(friendshipPath(a, b)).data.status == 'accepted';
    }

    // friendships/{uidA_uidB}: a friend request (pending) or a friendship (accepted).
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Send a request: you're one of the two people, you're the requester, it starts pending.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requestedBy', 'status', 'names', 'photos', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // Accept: only the person who received the request, and only the status changes.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      // Decline, cancel or unfriend: either person.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // notifications/{id}: only the person it's for can read it.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;

      // You can only send as yourself, to someone else.
      // Requests need a pending request from you; everything else needs you to be friends.
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.read == false
        && (
          (request.resource.data.type == 'friend_request'
            && exists(friendshipPath(request.auth.uid, request.resource.data.to))
            && get(friendshipPath(request.auth.uid, request.resource.data.to)).data.requestedBy == request.auth.uid)
          || (request.resource.data.type in ['friend_accepted', 'activity_invite']
            && areFriends(request.auth.uid, request.resource.data.to))
        );

      // The receiver can mark it read or delete it.
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.to == request.auth.uid;
    }

    // Everything else is closed until we add rules for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
